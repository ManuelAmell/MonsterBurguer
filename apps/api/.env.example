# Copiar a .env y ajustar. Nunca versionar .env.
NODE_ENV=development
PORT=3000
# Origen del frontend (CSRF: se valida la cabecera Origin en métodos mutantes)
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://mb:mb_dev_pass@localhost:5432/monsterburguer
# Base exclusiva para tests de integración (se vacía en cada corrida)
DATABASE_URL_TEST=postgres://mb:mb_dev_pass@localhost:5432/monsterburguer_test
SESSION_TTL_HORAS=12
TZ=America/Bogota
LOG_LEVEL=info
