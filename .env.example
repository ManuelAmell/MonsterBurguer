# Variables para `docker compose` (producción en la LAN del restaurante).
# Copiar a .env y definir valores propios. Nunca versionar .env.
POSTGRES_USER=mb
POSTGRES_PASSWORD=          # obligatorio: usa una clave larga y aleatoria
POSTGRES_DB=monsterburguer
APP_ORIGIN=http://localhost # con HTTPS (Caddy): https://pos.local y COOKIE_SECURE=true
COOKIE_SECURE=false
TRUST_PROXY=true
