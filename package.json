    "depcruise": "depcruise apps/api/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
